obj-$(CONFIG_PHY_AN7552_PCIE)		+= phy-an7552-pcie.o
obj-$(CONFIG_PHY_AN7583_PCIE)		+= phy-an7583-pcie.o phy-an7583-pcie-gen3.o
obj-$(CONFIG_PHY_AIROHA_PCIE)		+= phy-airoha-pcie.o

obj-$(CONFIG_PHY_AN7583_USB)		+= phy-an7583-usb.o
obj-$(CONFIG_PHY_AIROHA_USB)		+= phy-airoha-usb.o
