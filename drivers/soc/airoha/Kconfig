#
# Airoha SoC options
#

if ARCH_AIROHA

config MEMBLOCK_NPU_TX_58M
	bool "Large preallocated TX buffer for NPU wifi offload"
	depends on !CONFIG_MACH_AN7552
	default n
	help
	  Preallocate 58M memblock, this is default for Eagle.
	  Otherwise preallocate 26M memblock to save kernel RAM.

config MEMBLOCK_QDMA1
	bool "Preallocate HWF buffer for QDMA1 (LAN)"
	default y

config MEMBLOCK_QDMA2
	bool "Preallocate HWF buffer for QDMA2 (WAN)"
	default y

choice
	prompt "Choose HWF buffer size"
	default MEMBLOCK_QDMA_SIZE_4M
	depends on (MEMBLOCK_QDMA1 || MEMBLOCK_QDMA2)
	help
	  Number of entries in FoE Table

	config MEMBLOCK_QDMA_SIZE_4M
		bool "4MB"
	config MEMBLOCK_QDMA_SIZE_8M
		bool "8MB"
	config MEMBLOCK_QDMA_SIZE_16M
		bool "16MB"
endchoice

endif
