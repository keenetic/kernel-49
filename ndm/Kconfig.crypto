config  RALINK_HWCRYPTO
	tristate "HW Crypto Engine (EIP9x) support"
	depends on (RALINK_MT7621 || ECONET_EN75XX_MP || MACH_MT7623)
	default m

config RALINK_HWCRYPTO_ESP6
	bool "Offload ESP6 via Crypto Engine"
	depends on RALINK_HWCRYPTO
	depends on IPV6
	default n

config CRYPTO_DEV_MTK_AES
	tristate "MT7628 AES Engine support"
	depends on RALINK_MT7628
	default m

config CRYPTO_DEV_EIP93
	tristate "Support for EIP93 crypto HW accelerators"
	depends on (MACH_AN7552 || MACH_AN7581 || MACH_AN7583)
	help
	  EIP93 have various crypto HW accelerators. Select this if
	  you want to use the EIP93 modules for any of the crypto algorithms.

config CRYPTO_DEV_EIP93_DES
	bool "Register legacy DES / 3DES algorithm with the Crypto API"
	depends on CRYPTO_DEV_EIP93
	default n
	help
	  Selecting this will offload DES and 3DES ECB and CBC
	  crypto to the EIP-93 crypto engine.
